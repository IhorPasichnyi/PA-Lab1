<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

	<GarbageCollectionAdaptToEnvironment>false</GarbageCollectionAdaptToEnvironment>
	<ServerGarbageCollection>false</ServerGarbageCollection>
	<!-- Обмеження купи GC у байтах або відсотках (наприклад, 150 МБ = 157286400 байт) -->
	<GCHeapHardLimit>157286400</GCHeapHardLimit>
  </PropertyGroup>

</Project>
